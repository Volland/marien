CREATE NODE TABLE Person(id INT64 PRIMARY KEY, name STRING, country STRING, pep BOOL, kyc_verified DATE);
CREATE NODE TABLE Company(id INT64 PRIMARY KEY, name STRING, country STRING);
CREATE NODE TABLE Account(iban STRING PRIMARY KEY, currency STRING);
CREATE REL TABLE ShareholderOf(FROM Person TO Company, share DOUBLE);
CREATE REL TABLE Owns(FROM Company TO Company, share DOUBLE);
CREATE REL TABLE Holds(FROM Company TO Account, FROM Person TO Account);
CREATE (:Person {id: 1, name: 'Ana Petrova', country: 'BG', pep: false, kyc_verified: date('2026-03-01')});
CREATE (:Person {id: 2, name: 'Marco Rossi', country: 'IT', pep: false});
CREATE (:Person {id: 3, name: 'Lena Vogel', country: 'DE', pep: true, kyc_verified: date('2025-11-20')});
CREATE (:Person {id: 4, name: 'Tom Hale', country: 'GB', pep: false, kyc_verified: date('2024-01-10')});
CREATE (:Company {id: 10, name: 'Northwind Holdings', country: 'LU'});
CREATE (:Company {id: 11, name: 'Bluefin Trading', country: 'CY'});
CREATE (:Company {id: 12, name: 'Orchid Capital', country: 'MT'});
CREATE (:Company {id: 13, name: 'Kestrel Logistics', country: 'NL'});
CREATE (:Company {id: 14, name: 'Halcyon Ventures', country: 'VG'});
CREATE (:Account {iban: 'LU28 0019 4006 4475 0000', currency: 'EUR'});
CREATE (:Account {iban: 'CY17 0020 0128 0000 0012', currency: 'EUR'});
CREATE (:Account {iban: 'DE89 3704 0044 0532 0130', currency: 'EUR'});
CREATE (:Account {iban: 'NL91 ABNA 0417 1643 00', currency: 'EUR'});
MATCH (p:Person {id: 1}), (c:Company {id: 10}) CREATE (p)-[:ShareholderOf {share: 60.0}]->(c);
MATCH (p:Person {id: 2}), (c:Company {id: 10}) CREATE (p)-[:ShareholderOf {share: 40.0}]->(c);
MATCH (p:Person {id: 3}), (c:Company {id: 13}) CREATE (p)-[:ShareholderOf {share: 30.0}]->(c);
MATCH (p:Person {id: 4}), (c:Company {id: 13}) CREATE (p)-[:ShareholderOf {share: 15.0}]->(c);
MATCH (a:Company {id: 10}), (b:Company {id: 11}) CREATE (a)-[:Owns {share: 100.0}]->(b);
MATCH (a:Company {id: 11}), (b:Company {id: 12}) CREATE (a)-[:Owns {share: 55.0}]->(b);
MATCH (a:Company {id: 12}), (b:Company {id: 11}) CREATE (a)-[:Owns {share: 45.0}]->(b);
MATCH (a:Company {id: 14}), (b:Company {id: 13}) CREATE (a)-[:Owns {share: 55.0}]->(b);
MATCH (c:Company {id: 10}), (a:Account {iban: 'LU28 0019 4006 4475 0000'}) CREATE (c)-[:Holds]->(a);
MATCH (c:Company {id: 11}), (a:Account {iban: 'CY17 0020 0128 0000 0012'}) CREATE (c)-[:Holds]->(a);
MATCH (p:Person {id: 3}), (a:Account {iban: 'DE89 3704 0044 0532 0130'}) CREATE (p)-[:Holds]->(a);
MATCH (c:Company {id: 13}), (a:Account {iban: 'NL91 ABNA 0417 1643 00'}) CREATE (c)-[:Holds]->(a);
